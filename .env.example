# SolarPrice Insight - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ============================================
# Google Gemini API Configuration
# ============================================
# Required for AI-powered tariff recognition feature
# Get your API key at: https://makersuite.google.com/app/apikey
# or https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-actual-gemini-api-key-here

# Note: This key will be embedded in the client-side bundle
# NEVER commit your actual API key to version control
# Keep your .env.local file in .gitignore
